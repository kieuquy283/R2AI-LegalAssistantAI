# Cache directories (IMPORTANT: set to D: drive to avoid C: disk full)
HF_HOME=D:\huggingface_cache
HF_HUB_CACHE=D:\huggingface_cache\hub
TRANSFORMERS_CACHE=D:\huggingface_cache\transformers
TORCH_HOME=D:\huggingface_cache\torch

# HuggingFace API (for Qwen via Inference API)
HF_TOKEN=your-huggingface-token-here
HF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct:together

EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Hybrid Reranker (heuristic + cross-encoder)
HYBRID_RERANKER=true
HYBRID_RERANKER_HEURISTIC_TOP_K=30
HYBRID_RERANKER_BATCH_SIZE=16
HYBRID_RERANKER_MAX_LENGTH=256
HYBRID_RERANKER_CROSS_WEIGHT=0.7
# Device strategy: auto (try GPU first, fallback to CPU) | gpu (force GPU) | cpu (force CPU)
HYBRID_RERANKER_DEVICE_STRATEGY=auto
# API Reranker (SiliconFlow - alternative to local cross-encoder)
# Enable to use API reranker instead of local model
HYBRID_RERANKER_API_ENABLED=false
HYBRID_RERANKER_API_URL=https://api.siliconflow.com/v1/rerank
HYBRID_RERANKER_API_KEY=your-api-key-here
HYBRID_RERANKER_API_MODEL=Qwen/Qwen3-Reranker-0.6B

# LLM Configuration
# Option 1: HuggingFace Inference API (free tier)
LLM_PROVIDER=hf
HF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Option 2: OpenAI-compatible API (DashScope, OpenRouter, etc.)
# LLM_PROVIDER=openai
# QWEN_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your-api-key-here

LLM_MODEL=Qwen2.5-7B-Instruct
VECTOR_INDEX_PATH=data/indexes/default
METADATA_PATH=data/processed/articles.jsonl
SUBMISSION_PATH=data/submissions/results.json
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
HISTORY_TURNS=3
SHOW_REWRITTEN_QUERY=true
RAG_PIPELINE_MODE=adaptive
RETRIEVAL_BACKEND=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=
QDRANT_PATH=
QDRANT_API_KEY=
QDRANT_COLLECTION_DOCS=legal_docs
QDRANT_COLLECTION_ARTICLES=legal_articles
QDRANT_COLLECTION_CHUNKS=legal_chunks
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=Cosine
CANDIDATE_K_DOCS=50
CANDIDATE_K_ARTICLES=100
CANDIDATE_K_CHUNKS=150
CANDIDATE_K_SPARSE=150
CANDIDATE_K_TITLE=50
# Set to 0 to disable exact search (faster for large corpora)
# SKIP_EXACT_SEARCH=true
RERANK_TOP_N=50
MIN_CONTEXTS=1
MAX_CONTEXTS=8
MAX_DOCS=2
MAX_ARTICLES=3
ABSOLUTE_SCORE_THRESHOLD=0.45
RELATIVE_SCORE_THRESHOLD=0.75
CITATION_SCORE_THRESHOLD=0.50
